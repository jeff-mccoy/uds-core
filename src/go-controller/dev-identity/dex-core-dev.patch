@@ -0,0 +1,41 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package authproxy
+
+import (
+	"log/slog"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/dexidp/dex/connector"
+)
+
+func TestCoreClaimsRetainLiteralGroupsAndVerifiedEmailAuthority(t *testing.T) {
+	configuration := Config{GroupHeaderEncoding: "json", EmailVerifiedHeader: "X-Remote-Email-Verified"}
+	opened, err := configuration.Open("uds", slog.Default())
+	if err != nil {
+		t.Fatal(err)
+	}
+	callback := opened.(connector.CallbackConnector)
+	request := httptest.NewRequest("GET", "https://identity.example.test/callback/uds", nil)
+	request.Header.Set("X-Remote-User", "actual-user")
+	request.Header.Set("X-Remote-User-Id", "actual-user-id")
+	request.Header.Set("X-Remote-User-Email", "user@example.test")
+	request.Header.Set("X-Remote-Email-Verified", "false")
+	request.Header.Set("X-Remote-Group", `["/literal, /UDS Core/Admin"]`)
+	identity, err := callback.HandleCallback(connector.Scopes{}, nil, request)
+	if err != nil || identity.EmailVerified || !reflect.DeepEqual(identity.Groups, []string{"/literal, /UDS Core/Admin"}) {
+		t.Fatal("directory claim authority changed", identity, err)
+	}
+	request.Header.Set("X-Remote-Group", `invalid JSON`)
+	if _, err := callback.HandleCallback(connector.Scopes{}, nil, request); err == nil {
+		t.Fatal("invalid group state accepted")
+	}
+	request.Header.Set("X-Remote-Group", `[]`)
+	request.Header.Del("X-Remote-Email-Verified")
+	if _, err := callback.HandleCallback(connector.Scopes{}, nil, request); err == nil {
+		t.Fatal("unknown email verification accepted")
+	}
+}
diff --git a/connector/authproxy/refresh.go b/connector/authproxy/refresh.go
new file mode 100644
index 0000000..20a2209
--- /dev/null
+++ b/connector/authproxy/refresh.go
@@ -0,0 +1,99 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package authproxy
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"github.com/dexidp/dex/connector"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"time"
+)
+
+// Refresh is opt-in. Existing authproxy deployments keep their original
+// callback-only behavior. Core's private identity lookup requires mutual TLS
+// and refreshes group membership instead of trusting stale callback claims.
+type RefreshConfig struct {
+	Endpoint   string `json:"endpoint"`
+	RootCA     string `json:"rootCA"`
+	ClientCert string `json:"clientCert"`
+	ClientKey  string `json:"clientKey"`
+}
+
+type refreshCallback struct {
+	*callback
+	endpoint *url.URL
+	client   *http.Client
+}
+
+func newRefreshCallback(base *callback, cfg RefreshConfig) (connector.Connector, error) {
+	endpoint, err := url.Parse(cfg.Endpoint)
+	if err != nil || endpoint.Scheme != "https" || endpoint.Host == "" {
+		return nil, fmt.Errorf("authproxy refresh requires HTTPS endpoint")
+	}
+	roots := x509.NewCertPool()
+	raw, err := os.ReadFile(cfg.RootCA)
+	if err != nil || !roots.AppendCertsFromPEM(raw) {
+		return nil, fmt.Errorf("invalid authproxy refresh root CA")
+	}
+	certificate, err := tls.LoadX509KeyPair(cfg.ClientCert, cfg.ClientKey)
+	if err != nil {
+		return nil, fmt.Errorf("authproxy refresh client certificate: %w", err)
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: roots, Certificates: []tls.Certificate{certificate}}}
+	return &refreshCallback{callback: base, endpoint: endpoint, client: &http.Client{Transport: transport, Timeout: 5 * time.Second}}, nil
+}
+
+func (c *refreshCallback) Refresh(ctx context.Context, scopes connector.Scopes, identity connector.Identity) (connector.Identity, error) {
+	endpoint := *c.endpoint
+	query := endpoint.Query()
+	query.Set("userId", identity.UserID)
+	endpoint.RawQuery = query.Encode()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return connector.Identity{}, err
+	}
+	response, err := c.client.Do(request)
+	if err != nil {
+		return connector.Identity{}, err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return connector.Identity{}, fmt.Errorf("authproxy identity refresh rejected: %d", response.StatusCode)
+	}
+	var user struct {
+		ID, Username, Email string
+		Groups              []string
+		EmailVerified       bool
+		SessionVersion      uint64
+	}
+	if err := json.NewDecoder(io.LimitReader(response.Body, 1<<20)).Decode(&user); err != nil {
+		return connector.Identity{}, err
+	}
+	if user.ID != identity.UserID || user.Username == "" || user.Email == "" {
+		return connector.Identity{}, fmt.Errorf("authproxy identity refresh mismatch")
+	}
+	if c.sessionVersionHeader != "" {
+		var data struct {
+			Version uint64 `json:"version"`
+		}
+		if json.Unmarshal(identity.ConnectorData, &data) != nil || data.Version != user.SessionVersion {
+			return connector.Identity{}, fmt.Errorf("authproxy credential/session authority revoked")
+		}
+	}
+	identity.Username = user.Username
+	identity.PreferredUsername = user.Username
+	identity.Email = user.Email
+	if c.emailVerifiedHeader != "" {
+		identity.EmailVerified = user.EmailVerified
+	}
+	identity.Groups = user.Groups
+	return identity, nil
+}
diff --git a/server/development_identity.go b/server/development_identity.go
new file mode 100644
index 0000000..a25dfab
--- /dev/null
+++ b/server/development_identity.go
@@ -0,0 +1,134 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package server
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// DevelopmentIdentityConfig is opt-in and requires a private HTTPS authority
+// with mutual TLS. It supplies managed service-account claims after Dex's
+// ordinary client-secret verification. The caller cannot select identity,
+// groups, or additional audiences.
+type DevelopmentIdentityConfig struct {
+	Endpoint                  string `json:"endpoint"`
+	RootCA                    string `json:"rootCA"`
+	ClientCert                string `json:"clientCert"`
+	ClientKey                 string `json:"clientKey"`
+	UserAuthorizationEndpoint string `json:"userAuthorizationEndpoint,omitempty"`
+}
+
+type developmentIdentity struct {
+	endpoint                  *url.URL
+	client                    *http.Client
+	userAuthorizationEndpoint *url.URL
+}
+
+func newDevelopmentIdentity(cfg DevelopmentIdentityConfig) (*developmentIdentity, error) {
+	endpoint, err := url.Parse(cfg.Endpoint)
+	if err != nil || endpoint.Scheme != "https" || endpoint.Host == "" {
+		return nil, fmt.Errorf("development identity requires HTTPS")
+	}
+	raw, err := os.ReadFile(cfg.RootCA)
+	if err != nil {
+		return nil, err
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(raw) {
+		return nil, fmt.Errorf("invalid development identity trust root")
+	}
+	cert, err := tls.LoadX509KeyPair(cfg.ClientCert, cfg.ClientKey)
+	if err != nil {
+		return nil, err
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: roots, Certificates: []tls.Certificate{cert}}}
+	identity := &developmentIdentity{endpoint: endpoint, client: &http.Client{Transport: transport, Timeout: 5 * time.Second}}
+	if cfg.UserAuthorizationEndpoint != "" {
+		identity.userAuthorizationEndpoint, err = url.Parse(cfg.UserAuthorizationEndpoint)
+		if err != nil || identity.userAuthorizationEndpoint.Scheme != "https" || identity.userAuthorizationEndpoint.Host == "" {
+			return nil, fmt.Errorf("user authorization requires HTTPS")
+		}
+	}
+	return identity, nil
+}
+
+func (s *Server) authorizeDevelopmentUser(ctx context.Context, clientID, userID, connectorID string) error {
+	if s.developmentIdentity == nil || s.developmentIdentity.userAuthorizationEndpoint == nil || connectorID != "uds" {
+		return nil
+	}
+	endpoint := *s.developmentIdentity.userAuthorizationEndpoint
+	query := endpoint.Query()
+	query.Set("clientId", clientID)
+	query.Set("userId", userID)
+	endpoint.RawQuery = query.Encode()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return err
+	}
+	response, err := s.developmentIdentity.client.Do(request)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 204 {
+		return fmt.Errorf("development user authorization rejected: %d", response.StatusCode)
+	}
+	return nil
+}
+
+func (s *Server) handleDevelopmentClientCredentials(writer http.ResponseWriter, request *http.Request, client storage.Client) {
+	if s.developmentIdentity == nil || client.Public {
+		s.tokenErrHelper(writer, errUnauthorizedClient, "service-account grant unavailable", 401)
+		return
+	}
+	endpoint := *s.developmentIdentity.endpoint
+	query := endpoint.Query()
+	query.Set("clientId", client.ID)
+	endpoint.RawQuery = query.Encode()
+	lookup, err := http.NewRequestWithContext(request.Context(), http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		s.tokenErrHelper(writer, errServerError, "identity lookup unavailable", 503)
+		return
+	}
+	response, err := s.developmentIdentity.client.Do(lookup)
+	if err != nil {
+		s.tokenErrHelper(writer, errServerError, "identity lookup unavailable", 503)
+		return
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 200 {
+		s.tokenErrHelper(writer, errUnauthorizedClient, "service-account grant rejected", 401)
+		return
+	}
+	var identity struct {
+		ClientID, ID, Username string
+		Groups, Audiences      []string
+	}
+	if json.NewDecoder(io.LimitReader(response.Body, 1<<20)).Decode(&identity) != nil || identity.ClientID != client.ID || identity.ID == "" || identity.Username == "" {
+		s.tokenErrHelper(writer, errServerError, "invalid managed identity", 503)
+		return
+	}
+	scopes := []string{scopeProfile, scopeGroups}
+	for _, audience := range identity.Audiences {
+		scopes = append(scopes, "audience:server:client_id:"+audience)
+	}
+	claims := storage.Claims{UserID: identity.ID, Username: identity.Username, PreferredUsername: identity.Username, Groups: identity.Groups}
+	token, expiry, err := s.newAccessToken(request.Context(), client.ID, claims, scopes, "", "uds-service-account")
+	if err != nil {
+		s.tokenErrHelper(writer, errServerError, "could not issue service-account token", 503)
+		return
+	}
+	s.writeAccessToken(writer, &accessTokenResponse{AccessToken: token, TokenType: "bearer", ExpiresIn: int(expiry.Sub(s.now()).Seconds())})
+}
